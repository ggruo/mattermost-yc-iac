apiVersion: gwin.yandex.cloud/v1
kind: YCCertificate
metadata:
  name: notes
  namespace: notes
spec:
  certificateRef:
    certificateID: "${CERTIFICATE_ID}"
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: notes
  namespace: notes
  annotations:
    gwin.yandex.cloud/securityGroups: "${ALB_SECURITY_GROUP_ID}"
    gwin.yandex.cloud/subnets: "${SUBNET_ID}"
spec:
  gatewayClassName: gwin-default
  addresses:
    - type: gwin.yandex.cloud/autoIPv4
      value: auto
  listeners:
    - name: http
      hostname: "${APP_FQDN}"
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: Same
    - name: https
      hostname: "${APP_FQDN}"
      protocol: HTTPS
      port: 443
      allowedRoutes:
        namespaces:
          from: Same
      tls:
        mode: Terminate
        certificateRefs:
          - group: gwin.yandex.cloud
            kind: YCCertificate
            name: notes
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: notes-redirect
  namespace: notes
spec:
  parentRefs:
    - name: notes
      sectionName: http
  hostnames: ["${APP_FQDN}"]
  rules:
    - filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            statusCode: 301
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: notes
  namespace: notes
spec:
  parentRefs:
    - name: notes
      sectionName: https
  hostnames: ["${APP_FQDN}"]
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: notes-alb
          port: 80
